                "route_oauth_credentials": false
            },
            "env": {
                "RUNME_ROUTER_FALLBACK_OPENAI_API_KEY": "visr****oe8",
                "RUNME_ROUTER_FALLBACK_ANTHROPIC_API_KEY": "visr****oe8",
                "RUNME_ROUTER_FALLBACK_GOOGLE_API_KEY": "visr****oe8",
                "OPENAI_BASE_URL": "https://api.visr.dev/api/router/v1/openai/v1",
                "ANTHROPIC_BASE_URL": "https://api.visr.dev/api/router/v1/anthropic",
                "GOOGLE_GEMINI_BASE_URL": "https://api.visr.dev/api/router/v1/google"
            }
        }
    ],
    "datasets": [
        {
            "path": "skills/bundesliga-fantasy-trader/evals/regression"
        }
    ]
}