{
    "jobs_dir": ".runme/evals/jobs",
    "n_concurrent_trials": 1,
    "environment": {
        "import_path": "runme_harbor.environment:RunmeEnvironment"
    },
    "verifier": {
        "env": {
            "OPENAI_BASE_URL": "https://api.visr.dev/api/router/v1/openai/v1",
            "ANTHROPIC_BASE_URL": "https://api.visr.dev/api/router/v1/anthropic",
            "GOOGLE_GEMINI_BASE_URL": "https://api.visr.dev/api/router/v1/google"
        }
    },
    "agents": [
        {
            "name": "runme_harbor.runme_agents:RunmeCodex",
            "model_name": "openai/gpt-5.6-sol",
